+		},

+		{

+			name:               "exact path does not match subpath",

+			path:               "/health/live",

+			excludedExactPaths: []string{"/health"},

+			clientIP:           "10.0.0.1",

+			allowedIPs:         []string{"192.168.1.1"},

+			expectedStatus:     fiber.StatusForbidden,

+		},

+		{

