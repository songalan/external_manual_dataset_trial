+		}));
+
+		// 普通表（非软删除）
+		const posts = pgTable('posts', {
+			id: serial().primaryKey(),
+			title: text().notNull(),
+			userId: integer().references(() => users.id),
+		});
+
+		const schema = { users, posts };
